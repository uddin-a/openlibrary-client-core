{
  "compilerOptions": {
    /* Type Checking */
    "strict": true /* Enable all strict type-checking options. */,
    "noImplicitAny": true /* Raise error on expressions and declarations with an implied 'any' type. */,
    "strictNullChecks": true /* Enable strict null checks. */,
    "noImplicitThis": true /* Raise error on 'this' expressions with an implied 'any' type. */,
    "alwaysStrict": true /* Parse in strict mode and emit "use strict" for each source file. */,
    "noUnusedLocals": true /* Report errors on unused locals. */,
    "noUnusedParameters": true /* Report errors on unused parameters. */,
    "noFallthroughCasesInSwitch": true /* Report errors for fallthrough cases in switch statement. */,
    "noImplicitReturns": true /* Report error when not all code paths in function return a value. */,
    "forceConsistentCasingInFileNames": true /* Ensure that casing is consistent across a file system. */,

    /* Modules */
    "target": "ES2022" /* Specify ECMAScript target version. Use a modern target for cleaner output. */,
    "module": "ESNext" /* Specify module code generation: 'CommonJS', 'AMD', 'System', 'UMD', 'ES6', 'ES2015', 'ES2020', 'ES2022', 'ESNext', 'Node16', 'NodeNext'. */,
    "moduleResolution": "Node" /* Specify how modules are resolved. 'Node' for modern Node.js environments. */,
    "esModuleInterop": true /* Emit interoperability code for CJS/AMD/UMD modules. */,
    "allowSyntheticDefaultImports": true /* Allow default imports from modules with no default export. */,

    /* Emit */
    "declaration": true /* Generate .d.ts files for type definitions. Crucial for NPM packages. */,
    "declarationMap": true /* Generate sourcemaps for .d.ts files. Useful for debugging types. */,
    "sourceMap": true /* Generate corresponding .map file. */,
    "outDir": "./dist" /* Redirect output structure to the directory. */,
    "rootDir": "./src" /* Specify the root directory of input files. */,
    "noEmit": false /* DO NOT set to true. tsup handles transpilation, but TS needs to emit declarations. */,

    /* Advanced Options */
    "skipLibCheck": true /* Skip type checking of all declaration files (*.d.ts). */,
    "composite": false /* Enable project compilation. */,
    "allowJs": false /* Disallow JavaScript files from being compiled. */
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts"]
}
